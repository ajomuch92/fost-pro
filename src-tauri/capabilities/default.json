{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the forms shown as windows of their own",
  "windows": ["main", "form-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window"
  ]
}
